#!/usr/bin/env bash
#
# Never in the annals of software engineering was so much owed
# by so many to so few lines of code
#                                        -- Martin Fowler
#
##############################################################
# The groan framework is implemented by one script < 800 loc.
#
# variable/function naming conventions key:
# g_ - groan/global
# c_ - command level
# s_ - script/sub-command level
# u_ - utility function
# p_ - print function
# _* - private function
 
##############################################################
# Default metadata - our contribution to help
#
# Sub-commands sourced with METADATAONLY=true collate metadata
g_options_common_vertical=\
"
--help         | -H | -?  usage help for a command
--quiet        | -Q       quiet mode
--verbose      | -V       verbose output
--debug        | -D       users debug (all -GD)
--dry-run      | -N       refrain from action
--confirm      | -Y       perform action (not a dry run)
--config=<cfg> | -C=<cfg> alternative config
--theme=0                 select a theme (0=off)
"

g_options_common_horizontal=\
"
--help --quiet --verbose --debug
 -H     -Q      -V        -D
"

##############################################################
# http://redsymbol.net/articles/unofficial-bash-strict-mode/
# Unofficial "Bash Strict Mode"
#
set -euo pipefail
IFS=$'\n\t'
shopt -s nullglob # make sure globs are empty arrays if nothing is found
set -o allexport
NL=$'\n' # useful

##############################################################
# Traditionally every script calls this function
#
function me () # BASH_SOURCE
{
  $MEDEBUG && printf "\n\e[2m${1%/*}/\e[1m${1##*/}\e[0m\n" # dim/bold
  my_path=$(cd -- "$(dirname -- "${1}")" 2>/dev/null && printf '%s/%s\n' "$(pwd -P)" "$(basename -- "${1}")")
}

##############################################################
# A customising config loads first, setting where to find 
# everything else, including config.
# Defaults are set here, and each executable may have a
# <exe>.conf (or perhaps a hidden .<exe>.conf)
#
# The first layer is "code defined" in the code below
# The second layer is "code defined" in the config dir, via the commands own name
# The third layer is "context defined", via the containing directory name
#   So - when the same code is used in a different context (containing directory),
#   values can be overridden using that context name.

function g_readConfig () # from conf files
{
  g_parseScriptPath "$1"
  local commands_folder="${2:-commands}"

  c_dir="$s_dir"
  c_file="$s_file"
  c_path="$s_path"
  [[ "$s_cmd" == "$g_file" ]] && c_cmd="$g_cmd" && s_cmd="$g_cmd" ||  c_cmd="${s_cmd}"
  c_dirname="${s_dir##*/}"
 
  c_description_default="$g_context ${c_cmd} tool"
  s_select_fn="${s_select_fn:-s_select_BEST}" # set if not set

  # Sub-command file types recognised by the dispatcher. The first entry
  # is the "primary" type shown by --list; the rest are surfaced by --all.
  #   cmd  - active sub-commands (the default)
  #   red  - red: test cases not yet passing
  #   wip  - work in progress, not yet stable
  #   obs  - obsolete; kept for reference but not surfaced
  #   test - test scripts
  #   spec - specification scripts
  g_types=( cmd red wip obs test spec )
  
  g_tmp=/tmp # TempDir for Linux ... or Windows
  #git bash has /tmp
  #[[ "$u_PLATFORM" == *msys* ]] && g_tmp="$HOME/AppData/Local/Temp"

  bold=$'\e[1m'      # Style Bold
  dim=$'\e[2m'       # Style Dim
  italic=$'\e[3m'    # Style Italic
  underline=$'\e[4m' # underline
  reversed=$'\e[7m'  # reversed
  reset=$'\e[0m'     # Reset
  
  case $THEME in
    none | off | 0)
      bold=$''           # Style Bold
      dim=$''            # Style Dim
      italic=$''         # Style Italic
      underline=$'' # underline
      reversed=$''  # reversed
      reset=$''          # Reset
    ;;
  esac

  g_config_file_options=(   "global"           "context"             "user")
  g_config_file_locations=( "${g_dir}/config"  "${g_dir}/../config"  "$HOME/.config/${g_dirname}" )

  g_subcmd_locations=( "${c_dir}/${commands_folder}" "${c_dir}"  "${c_dir}/help" )

  #c_dir c_name globals used within <name>.conf file

  # Read customization from
  g_find 'Custom0 ' ".${c_file}.conf"   "${c_dir}"                                 && source "$g_found"
  g_find 'Custom1 ' "${c_file}.conf"    "${c_dir}" "${g_config_file_locations[@]}" && source "$g_found"
  g_find 'Custom2 ' "${c_dirname}.conf" "${g_config_file_locations[@]}"            && source "$g_found"
    
  # Obtain config from...
  if g_find 'Config  ' "${CONFIG:-default}.conf" "${g_config_file_locations[@]}"
  then
    g_config_path="${g_found}"
    g_config_name="${g_config_path##*/}"
    g_config_name="${g_config_name%.conf}"
    source "${g_config_path}"
  fi

  c_description="${c_description:-$c_description_default}"

  return 0
}

function g_readConfig_TopLevel () # parameters come from me() 
{
  g_path="$1"
  g_dir="${1%/*}"
  g_dirname="${g_dir##*/}"
  g_file="${1##*/}" # backup for when g_cmd is overriden

  g_home="$(p_dir "$g_dir")"
  [[ -z ${g_context+x} ]] && g_context="${g_dirname}"
  g_cmd="${g_cmd:-$g_file}" # allows runtime override via ==g_cmd=toolname

  # g_options+="${NL}--theme=neon ; alternate theme\n"
  breadcrumbs="${g_cmd}"
  g_actionDefault="g_option--list"
}

##############################################################
# search g_config_file_locations set in g_readConfig
# find a <filename>

function g_find () #1) type_string #2) filename #) dirs to look
{
  local dir file type="${1}" name="${2}" ; shift ; shift
	for dir in "$@"
    do
       g_found="${dir}/${name}"

       if [[ -f "${g_found}" ]]; then         
          $GDEBUG || $CDEBUG && p_echo "${type}< $(p_dir "$dir")/${name}"
          return 0
       fi
       $CDEBUG && p_echo "${type}? $(p_dir "$dir")/${name}"
    done
    return 1 # no file found
}

# Prints paths taking the opportunity to abbreviate where possible
#
function p_dir ()
{
  local p_dir="${1/$PWD/\$PWD}"         # remove current path
  p_dir="${p_dir/${g_dir:-}/\$g_dir}"   # subst cmd dirg for '$g_dir'
  printf "${p_dir/$HOME/\$HOME}"        # subst home dir for '$HOME'
}

##############################################################
# rudimentary yaml parser
function u_parseYaml {
   local prefix=$2
   local s='[[:space:]]*' w='[a-zA-Z0-9_]*' fs=$'\034'
   sed -ne "s|^\($s\):|\1|" \
        -e "s|^\($s\)\($w\)$s:$s[\"']\(.*\)[\"']$s\$|\1$fs\2$fs\3|p" \
        -e "s|^\($s\)\($w\)$s:$s\(.*\)$s\$|\1$fs\2$fs\3|p"  $1 |
   awk -F$fs '{
      indent = length($1)/2;
      vname[indent] = $2;
      for (i in vname) {if (i > indent) {delete vname[i]}}
      if (length($3) > 0) {
         vn=""; for (i=0; i<indent; i++) {vn=(vn)(vname[i])("_")}
         printf("%s%s%s=\"%s\"\n", "'$prefix'",vn, $2, $3);
      }
   }'
}

##############################################################
# useful
function u_joinInto () {
    # $1 is return variable name
    # $2 is sep
    # $3... are the elements to join
    local retname=$1 sep="$2" ret="${3:-}"
    shift 3 || shift $(($#))
    printf -v "$retname" "%s" "$ret${@/#/$sep}"
}

##############################################################
# useful
function u_splitInto() {
    # $1 is return array variable name
    # $2 is sep (single char)
    IFS="$2" read -r -a "$1" <<< "$3"
}

##############################################################
# define a multiline string variable
#
# > u_define my_variable <<EOF
# > This is an
# > example
# > EOF
#
function u_define () { IFS='\n' read -r -d '' ${1} || true; }

function u_includes ()
{
  declare -n arr="${1}"       # dynamically declare arr[] as a name ref to data_male[]

  for ea in "${arr[@]}" ; do
    [[ "$ea" == "$2" ]] && return 0
  done
  return 1
}

##############################################################
# A standard means for platform differentiation
# OS                u_PLATFORM                 OSTYPE
# MacOS X         - x86_64-apple-darwin22.1.0  darwin22.1.0
# Windows GitBash - x86_64-pc-msys             msys

u_PLATFORM="${BASH_VERSINFO[5]:-$OSTYPE}" # || use $OSTYPE

##############################################################
# Ensure that sudo is available
#
function u_needsSudo() {
    local prompt
    prompt=$(sudo -nv 2>&1)
    if [ $? -eq 0 ]; then
       $GDEBUG && p_echo "User has 'sudo' access."
    elif p_echo "$prompt" | grep -q '^sudo:'; then
       $GDEBUG && p_echo "User has sudo (password required)"
    else
       p_echo "this action requires 'sudo' access."
       exit 1
    fi
}

function u_deleteLines 	# in-place one liner
{
	sed -i "/${2}/,/${3:-$2}/d" "$1"
}

##############################################################
#
function g_executeScriptPath ()
{
  local bk=("${g_subcmd_locations[@]}")
  _g_executeScriptPath "$@"
  g_subcmd_locations=("${bk[@]}")
}

function _g_executeScriptPath ()
{  
  g_parseScriptPath "$1"
  #s_alias="${s_alias:-$s_cmd}" 
  # When set -u is enabled bash<=4.1, this pattern
  # is needed: "${args[@]:+${args[@]}}"

  $METADATAONLY && local status="Metadata" || local status="Running"

  case "${s_ext}" in
    conf)
        $GDEBUG && p_echo "$status< $s_path"
        g_pathScriptMappingArgs "$s_path" "${args[@]:+${args[@]}}" && $METADATAONLY && return 0

        for script in "${s_dir}/${s_file%.*.conf}" "${s_dir}/${s_file%.*.conf}".*
        do
          if [[ "$script" != "$s_path" ]] && [[ -f "$script" ]]; then
            g_executeScriptPath "$script" "${args[@]:+${args[@]}}"
              
            $SHOWHELP && g_displayHelp && exit  # moved to post dispatch
            $METADATAONLY && return 0            
            exit
          fi
        done
    ;;
    sh)
        $GDEBUG && p_echo "$status source> $(p_dir "$s_path") ${args[@]:+${args[@]}}"        
        $XDEBUG && set -x
        g_pathScriptMappingArgs "$s_path" "${args[@]:+${args[@]}}"
        $XDEBUG && set +x
    ;;
    exec)
        $GDEBUG && p_echo "$status exec> $(p_dir "$s_path") ${args[@]:+${args[@]}}"

        $METADATAONLY && g_pathScriptMappingArgs "$s_path" "${args[@]:+${args[@]}}" \
                      || exec "$s_path" "${args[@]:+${args[@]}}"

    ;;
    ps1)
        $GDEBUG && p_echo "$status exec> $(p_dir "$s_path") ${args[@]:+${args[@]}}"
        exec powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$s_path" "${args[@]:+${args[@]}}"
    ;; 
    su)
        $GDEBUG && p_echo "$status sudo> $(p_dir "$s_path") ${args[@]:+${args[@]}}"
        sudo "$s_path" "${args[@]:+${args[@]}}"
    ;;
    *)
        # Refuse to eval scripts that live outside the configured
        # sub-command locations. A symlink in commands/ pointing at a
        # hostile file would otherwise be eval'd here. We resolve
        # symlinks and confirm the resolved path is under one of the
        # g_subcmd_locations[] directories.
        local resolved safe=false
        if command -v realpath >/dev/null 2>&1; then
            resolved="$(realpath "$s_path" 2>/dev/null)"
        else
            resolved="$(cd -- "$(dirname -- "$s_path")" 2>/dev/null && pwd -P)/$(basename -- "$s_path")"
        fi
        [[ -z "$resolved" ]] && { $LOUD && p_echo "Refused: cannot resolve $s_path"; return 1; }
        for allowed in "${g_subcmd_locations[@]}"; do
            if [[ "$resolved" == "$allowed"/* ]] || [[ "$resolved" == "$allowed" ]]; then
                safe=true
                break
            fi
        done
        if ! $safe; then
            $LOUD && p_echo "Refused: $s_path resolves outside sub-command locations"
            return 1
        fi
        $GDEBUG && p_echo "$status eval> $(p_dir "$s_path") ${args[@]:+${args[@]}}"
        $XDEBUG && set -x
        eval "$s_path" "${args[@]:+${args[@]}}"
        $XDEBUG && set +x
        exit 0
    ;;
  esac
  return 0 # needed due to use of &&
}

##############################################################
# Sourcing a script is done via this function
# so that args are automatically mapped in to $@
function g_pathScriptMappingArgs
{
	local source="$1" ; shift
  source "$source"
}

##############################################################
#
# If description is not defined - no help is displayed.
#
# Help is in three parts: description, options, usage
# Each has a main and supplementary
#   - $s_description and $s_description_
#   - $s_opts     and $g_options_
#   - $s_usage       and $s_usage_
#
# Description - is displayed with the first line in bold
# Options - section titled in bold 'options:'
# Usage   - section titled in bold 'usage:'
# 
s_opts=""; g_options=""; s_usage=""; s_usage_=""

function g_displayHelp {

  p_command_description

  [[ -n ${s_description+x} ]] && p_description

  p_options
  
  p_usage

  return 0
}

function _p_command_description ()
{
  p_embolden_first_line "${c_description}"
  printf "${c_description_:-\n}${c_description_+\n}"
}

function p_command_description ()
{
  _p_command_description
}

function _p_description ()
{
  p_embolden_first_line "${s_description:-$s_cmd}\n"
}

function p_description ()
{
  _p_description
}

function p_first_line ()
{
    local line
    for line in $(printf "$1")
    do
      printf "$line"
      return 0
    done
}

function p_command_list_description ()
{
  p_first_line "${s_description:-$s_cmd}"
}

function p_embolden_first_line () # (ignores empty first line)
{
  local first=true
  while read -r line
  do
    if $first; then
      if [[ -n "$line" ]]; then
        printf "$bold$line$reset\n" # use bold or be bold
        first=false
      fi
    else
      printf "$line\n"
    fi
  done <<<"$1"
}

function bold ()
{
  printf "${bold}%s${reset}\n" "$($@)"
}

function loud ()
{
  $LOUD && $@
}

function _p_options ()
{
  if [[ -z "${s_opts}" ]]; then
    printf "\n%s\n" "${g_options_common_vertical}"
  else
    printf "%s%s" "${g_options_common_horizontal}" 
  fi
 
  p_cols "${s_opts:-$g_options}" " ; " 
  echo
}

function p_options ()
{
  printf "${bold}options:${reset} "
  _p_options
}

function _p_usage ()
{
  p_cols "${s_usage:-\n$breadcrumbs}B" 
  echo
}

function p_usage ()
{
  bold echo "usage:"   
  _p_usage

  [[ -n ${s_usage_+x} ]] && printf "${s_usage_}"
  return 0
}

function p_kv ()
{
  $LOUD && echo "${bold}${1}:${reset} ${2:-}${2:+ }${dim}${3:-}${reset}" || echo "${2:-}"
  return 0 # needed
}

function g_debug_kv ()
{
  $GDEBUG && p_kv "${1}" "${!1:-}${2:-}"
  return 0 #(neded)
}

function p_echo () {
  >&2 $LOUD && echo "$@" # or { printf "%s\n" "$*" >&2; }
}

g_option_vars=()
function g_declare_options ()
{
  g_option_vars+=( "$@" )
  for ea in "$@"; do
    local val="${ea#*=}"
    [[ "$val" == "$ea" ]] && val=false
    declare -g "${ea%%=*}"="${val}"
  done
}

function _g_bashrc_ ()
{
  local name="$1" alias_text="$2"

cat <<RCD
alias $name='${alias_text}' ##:$name:##
_ac_$name () { COMPREPLY=( \$(${alias_text} \${COMP_WORDS[@]:1} -- ---AUTOCOMPLETE) ); } ##:$name:##
# complete -F _ac_$name ${name}          ##:$name:##
RCD

}

function g_bashrc_install ()
{
  #2) dest file - "$HOME/.bashrc"
  local name="$1" dest="$2" alias_text="$3" wip="${g_tmp}/${2////-}"
  
  # backup
	touch "$dest" 
	cp "$dest" "$wip" || true

	$GDEBUG && p_echo "Before:" && cat "$wip"

	u_deleteLines "$wip" "##:$name:##"

	$GDEBUG && p_echo "Cleaned:" && cat "$wip" && echo

  # append
	touch "$wip"
	_g_bashrc_ "$name" "$alias_text" >> "$wip"

  $VERBOSE && p_echo "${dim}updating ${dest}${reset}" && cat "$wip" || true
	$CONFIRM && cp "$wip" "$dest"
  :
}

