##############################################################
# Should simply be ${args[@]:1} but bash begs to differ:
#
function g_shiftInto_g_next ()
{
    g_prev="${g_next:-}"
    g_next=""
    local arg params=() found=false
    if [[ "${#args[@]}" -gt 0  ]]; then
      for arg in "${args[@]}"
      do 
        if ! $found; then
          if [[ "$arg" == '--' ]]; then
            found=true
            continue
          elif [[ "${arg:0:1}" != "-" ]]; then
            g_next="$arg"
            found=true
            continue
          fi
        fi
        params+=("$arg") 
      done
    fi
    args=("${params[@]:+${params[@]}}")
    [[ -n "${g_next}" ]]
}

function g_parseScriptPath ()
{
  s_path="$1"
  s_file="${s_path##*/}"    # path, removing upto last '/'
  s_dir="${s_path%/*}"      # path, removing after last '/'
  s_cmd="${s_file%%.*}"     # name, up to first '.'
  s_ext="${s_file##*.}"     # name, remove up to last '.'
  s_base="${s_file%.*}"     # name, keep up to last '.'
  s_rest="${s_base#*.*.}"   # base, remove up to second dot
}

# Extended parser used to recognise dispatcher aliases of the form
# <X>.sub.<Y>.cmd.<Z>.<ext> — i.e. sub-command X dispatches into command Y
# passing Z as the next argument.
# Sets s_sub_cmd, s_dest_cmd, s_dest_path, s_dest_subcmd_name and
# s_isDispatcher in the caller's scope.
function g_parseScriptPathMore ()
{
  # First set the basic s_* fields via the shared parser so the
  # dispatcher-specific code below can rely on them.
  g_parseScriptPath "$1"

  s_sub_cmd=""
  s_dest_cmd=""
  s_dest_path=""
  s_dest_subcmd_name=""
  s_isDispatcher=false

  local scriptRoute="${s_file%%.cmd.*}"

  if [[ "$scriptRoute" =~ \.sub\. ]]; then
    if [[ -f "$s_path" ]]; then
      s_sub_cmd="${scriptRoute%%.sub.*}"
      s_dest_cmd="${scriptRoute#*sub.}"
      s_dest_path="${s_dir%/*}/${s_dest_cmd}/${s_dest_cmd:-$c_file}"
      s_dest_subcmd_name="${s_file#*.cmd.}"
      [[ "$s_dest_subcmd_name" == *.sub.* ]] && s_isDispatcher=false || s_isDispatcher=true
    fi
  fi
}

function g_aliasDispatch ()
{
  s_alias="$s_cmd"
  g_dispatch "$@"
}

function g_nextDispatch ()
{
  if g_shiftInto_g_next; then
    crumbs+=" K${g_next}K"
    g_dispatch "$g_next"
  else
    [[ "${s_path}" == "${g_path}" ]] && g_optionsTopLevelOnly
    crumbs+="$breadcrumbs N${crumb:-}N"
    g_actions
  fi
}

function g_dispatch ()
{
  if g_findSubCommandScript "${1}"; then

    g_executeScriptPath "$s_path" "${args[@]:+${args[@]}}"

    $SHOWHELP && g_displayHelp && exit 0
    $METADATAONLY && return 0 || exit 0

  else # not found

    $LOUD && p_echo "Not Found: $breadcrumbs"
    exit 1
  fi
}

function g_findSubCommandScript ()
{
  s_cmd="$1"

  local found=() found_cmd=() found_type=()
  
  for s_type in "${g_types[@]}"
  do
    local target="${s_cmd}*.${s_type}.*"
    local exact="${s_cmd}.${s_type}.*"

    for s_dir in "${g_subcmd_locations[@]}"
    do
      for s_path in "$s_dir"/$exact
      do
        target="$exact" # upgrade the target to prioritize the exact match
      done
    done

    for s_dir in "${g_subcmd_locations[@]}"
    do
      $GDEBUG && p_echo "Scanning for $target in: $(p_dir "$s_dir")"

      for s_path in "$s_dir"/$target
      do
        g_parseScriptPath "$s_path"
        found+=("$s_path")
        found_cmd+=("$s_cmd")
        found_type+=("$s_type")
        $GDEBUG && p_echo "Found #${#found[@]} : $s_cmd : $(p_dir "$s_path")"       
      done
    done
  done

  if [ ${#found[@]} -gt 1 ]; then
    $LOUD && echo "Multiple matches found for '${g_next}' (${found_cmd[@]})"
    exit 1
  fi

  if [ ${#found[@]} -eq 0 ]; then
    # if we were trying the default command and did not find it"
    s_type="" ; s_path="" ; s_cmd="" ; s_dir=""
    return 1
  fi
  
  s_type="${found_type[0]}"

  return 0
}

# Scan each sub command available, all locations and types 
# $1) filter function name
# $2) action function name

function g_eachSubMetaDo ()
{
  local filter="$1" ; shift 
  local action="$1" ; shift 
  local found=false
  local type s_dir path
  for type in "${g_types[@]}"
  do
    for dir in "${g_subcmd_locations[@]}"
    do
      for path in "$dir"/*.$type.*
      do
        if [[ -f "$path" ]]; then
          unset s_alias  s_path c_dir s_dir s_description c_cmd
          METADATAONLY=true g_executeScriptPath "$path" ""
          $filter && $action ${@} && found=true
        fi
      done
    done
  done
  [[ "$found" == true ]]
}

function s_select_ALL ()
{
  [[ -z ${c_cmd+x} ]] && [[ -n ${s_cmd+x} ]]
}

function s_select_BEST ()
{
  s_select_ALL && { $VERBOSE || [[ "$type" == "${g_types[0]}" ]] } 
}

function c_select ()
{
  [[ "${c_cmd:-}" == "$s_cmd" ]]
}

function p_scriptEntry ()
{ 
