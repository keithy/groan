  [[ "$type" != "${g_types[0]}" ]] && printf " ($type)"
  echo
}

function p_c1 ()
{
  printf "%-${bw}s" "${1}"
}

function p_cols ()
{
  printf -- "${1}" | column -c 2 -s ';' -t 2> /dev/null || true
  return 0
}

function p_cmdDefaultEntry ()
{
