}

function g_listCmds()
{
	local crumbs

	if [[ -z ${1+x} ]]; then
		# When invoked from inside a sub-suite (e.g. via a dispatcher's
		# g_actions fallback), c_cmd carries the sub-suite's name and
		# breadcrumbs is still the top-level value. Mirror g_listAllSubCmds
		# logic so the same fix applies.
		if [[ -n "${c_cmd+x}" ]] && [[ "${c_cmd}" != "${g_cmd}" ]]; then
			crumbs="${breadcrumbs} ${s_sub_cmd:-${c_cmd}}"
		else
			crumbs="${breadcrumbs}"
		fi
	else
		crumbs="$1"
	fi

  local bw=$(( ${#crumbs} + ${breadcrumbs_width:-20} ))
 
  #p_embolden_first_line "${c_description}\n" 
  p_command_description
  
  bold echo "commands:"
  p_cmdDefaultEntry "$crumbs" " (this list)"  
  # p_c1 "$crumbs" ; echo "this list"

  g_eachSubMetaDo c_select p_scriptEntry "${crumbs}" && echo
  g_eachSubMetaDo $s_select_fn p_scriptEntry "${crumbs}" && echo
  :
}

function g_listAllSubCmds ()
{
  local crumbs

  if [[ -z ${1+x} ]]; then
    list=()
    # When --all is dispatched from inside a sub-suite (e.g. from a
    # dispatcher's g_actions), we are NOT running at the top level.
    # c_cmd will have been set by the dispatcher's g_readConfig to the
    # sub-suite's command name (e.g. "setup-utility"), but the user
    # invoked the dispatcher alias ("setup"). The dispatcher sets
    # s_sub_cmd to the alias name; prefer that over c_cmd for the
    # breadcrumb so listings show "groan setup configure" rather than
    # "groan setup-utility configure".
    if [[ -n "${c_cmd+x}" ]] && [[ "${c_cmd}" != "${g_cmd}" ]]; then
      crumbs="${breadcrumbs} ${s_sub_cmd:-${c_cmd}}"
    else
      crumbs="${breadcrumbs}"
    fi
  else
    crumbs="$1 ${crumb:-}"
  fi

  # p_kv breadcrumbs "$breadcrumbs $g_next $s_cmd $c_cmd"

  local bw=$(( ${#crumbs} + ${breadcrumbs_width:-20} ))

  u_includes list "$crumbs" && return 0

  list+=("$crumbs")
  # The dispatcher that called us has already re-anchored g_subcmd_locations
  # to its destination suite via g_readConfig. The top-level framework has
  # already been configured by the entry-point g_readConfig_TopLevel call.
  # Re-anchoring here would overwrite g_file and breadcrumbs (currently
  # $my_path = dispatcher's path, not the top-level entry's), which would
  # break descriptions and default-entry breadcrumbs throughout the
  # listing. Do nothing on this line.

  # Snapshot g_locations BEFORE sourcing any sub-commands. Dispatcher
  # files themselves call g_readConfig to re-anchor to their destination
  # suite, which mutates g_locations. Without this snapshot, the for
  # loop below would scan the destination's commands, not this level's.
  local -a iteration_locations
  iteration_locations=("${g_subcmd_locations[@]}")

  p_description

  bold p_cmdDefaultEntry "$crumbs"
  g_eachSubMetaDo $s_select_fn p_scriptEntry "$crumbs" && echo || true

  # Recurse into dispatcher aliases: walk g_locations[], find files matching
  # *.sub.*.cmd.* that are dispatcher aliases (s_isDispatcher=true), and
  # re-enter at the destination suite. c_select (the previous filter,
  # c_cmd == s_cmd) only matched the legacy self-titled nesting pattern;
  # the dispatcher pattern below is the modern one.
  #
  # We restore iteration_locations after each recursive call so the
  # next iteration of the for loop scans the caller's commands, not the
  # destination's.

  for s_dir in "${iteration_locations[@]}" ; do
    for s_path in "$s_dir"/*.sub.*.cmd.* ; do
      [[ -f "$s_path" ]] || continue
      g_parseScriptPathMore "$s_path"
      $s_isDispatcher || continue
      [[ -n "$s_dest_cmd" ]] || continue

      # Source the dispatcher so its s_description/s_usage become available.
      METADATAONLY=true g_executeScriptPath "$s_path" ""

      # Re-anchor to the destination suite and recurse with an extended crumb.
      g_readConfig "${s_dir%/*}/${s_dest_cmd}/${s_dest_cmd}"
      g_listAllSubCmds "${crumbs} ${s_sub_cmd}"

      # Restore g_locations so the next iteration of the for loop scans
      # the caller's commands, not the destination's.
      g_subcmd_locations=("${iteration_locations[@]}")
    done
  done
}

function _g_optionsTopLevelOnly ()
{
  g_options+=" ; \n"
  g_options+="--version ; git version\n"

  function g_option--version ()
  {
    printf "$g_home "
    bold git  --git-dir="$g_dir/.git" --work-tree="$g_dir" describe --long --tags --dirty --always 2> /dev/null
  }

  g_options+="--install | --uninstall ; install as bash alias\n"
  g_options+="--install=<name> ; install as bash alias <name>\n"
  g_options+="--install=<name> --config=<alt> ; install with config <alt>\n"

  function g_option--install ()
  {
    g_bashrc_install "${2:-$g_cmd}" "$HOME/.bashrc" \
      "${g_path/$HOME/\$HOME}${2+ ==g_cmd=}${2:-}${CONFIG+ --config=}${CONFIG:-}"

    $CONFIRM \
      && p_echo "To use the installed feature - start a new bash" \
      || p_echo "DRY-RUN --confirm to apply"   
  }

  function g_option--uninstall ()
  {
    $CONFIRM \
      && u_deleteLines "$HOME/.bashrc" "##:$g_cmd:##" \
      || p_echo "DRY-RUN --confirm to apply"
  }

  s_usage+="$breadcrumbs ; list commands\n"
  s_usage+="$breadcrumbs --install ; install as bash alias\n"
  s_usage+="$breadcrumbs --install=tool -C=tool ; install as bash alias with config\n"

  g_options+="--update ; git pull latest\n"

  function g_option--update ()
  {
    $CONFIRM \
      && git --git-dir="$g_dir/.git" --work-tree="$g_dir" pull \
      || p_echo "DRY-RUN --confirm to apply"
  }
  
  g_options+="--configs ; list available config files\n"
  function g_option--configs ()
  {
    for each in $(find "${@:-${g_config_file_locations[@]}}" -name "*.conf" 2> /dev/null)
    do
      echo "${each##*/}"
    done
  }
}

function g_optionsTopLevelOnly ()
{
  _g_optionsTopLevelOnly
}

function g_actions ()
{
  $METADATAONLY && return 0

  # since help doesn't exec anything many common options don't apply
  g_options_common_vertical=""

  g_declare_options LIST_ALL_CMD LIST_CMD=true
  
  for arg in "${args[@]:+${args[@]}}"
  do
    case "$arg" in
      --*=* | --* )
        local opt="${arg%%=*}" param="${arg#*=}"
        [[ $(type -t g_option${opt}) == function ]] \
          && g_option${opt} "${param}" "${args[@]:+${args[@]}}" && exit 0
      ;;
    esac
  done

  $g_actionDefault
}

##############################################################
# Parsing options the groan way - first initialize all flags
#
g_declare_options METADATAONLY SHOWHELP CONFIRM DRYRUN=true "THEME=${THEME:-default}"

##############################################################
# Debug verbosity levels
# DEBUG  -D  User level Debug (for non-groan code)
# DDEBUG -DD Developer level "Deep" Debug (for non-groan code)
# GDEBUG -GD Groan Debug (for groan code)
# CDEBUG -CD Config Debug (shows all locations searched for config)
# XDEBUG -XD Bash shell debugging using set -x

g_declare_options MEDEBUG XDEBUG DDEBUG DEBUG GDEBUG CDEBUG VERBOSE ENVIRONMENT LOUD=true

##############################################################
# Top level - universal options processing pattern
#
args=()
for arg in "$@"
do
    shift # needed for the -- option
    case "$arg" in
      -- )
        args+=( '--' "$@" )
        break
      ;;
      ==*=* )
        arg="${arg#==}"
        declare "${arg%%=*}"="${arg#*=}"
      ;;
      ==* )
        show_me_variable="${arg#==}"
      ;;
      -EXIT=* )
        trap "g_onEXIT__${arg#-EXIT=}" EXIT
      ;;
      -DD | --ddebug | --deep-debug) 
        DDEBUG=true
      ;;
      -GD | --groan-debug)
        MEDEBUG=true
        GDEBUG=true
        DEBUG=true
        VERBOSE=true
        LOUD=true
      ;;
      -CD | --config-debug)
        MEDEBUG=true
        CDEBUG=true
      ;;
      -XD | --bash-debug)
        XDEBUG=true
      ;;
      -D | --debug)
        DEBUG=true
        VERBOSE=true
        LOUD=true
      ;;
      --help | -H | '-?' )
        SHOWHELP=true
        METADATAONLY=true
      ;;
      --verbose | -V )
        GDEBUG=false
        DEBUG=false
        VERBOSE=true
        LOUD=true
      ;;
      --quiet | -Q )
        LOUD=false
        GDEBUG=false
        VERBOSE=false
      ;;
      --dry-run | -N )
        DRYRUN=true
        CONFIRM=false
      ;;
      --confirm| -Y )
        DRYRUN=false
        CONFIRM=true
      ;;
      --config=* )
        CONFIG="${arg##--config=}"
      ;;
      -C=* )
        CONFIG="${arg##-C=}"
      ;;
      --theme=* )
        THEME="${arg##--theme=}"
      ;;
      * )
        args+=("$arg")
      ;;
    esac
done

